{
  "manifest_version": 3,
  "name": "Favoright",
  "version": "0.1.0",
  "description": "Finds favorites that no longer work and makes folder names easier to spot.",
  "homepage_url": "https://github.com/stevencohn/Favoright",
  "permissions": ["bookmarks", "storage"],
  "optional_permissions": ["history"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Favoright",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
